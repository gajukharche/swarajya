generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String              @id @default(cuid())
  title          String
  handle         String              @unique
  description    String?
  vendor         String?
  productType    String?
  status         ProductStatus       @default(DRAFT)
  tags           String[]            @default([])
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  options        ProductOption[]
  variants       ProductVariant[]
  media          ProductMedia[]
  collections    CollectionProduct[]

  @@index([status, handle])
}

model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String               // e.g. "Size", "Color"
  position  Int                  @default(0)
  values    ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id        String        @id @default(cuid())
  optionId  String
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String        // e.g. "Small", "Black"
  position  Int           @default(0)

  @@index([optionId])
}

model ProductVariant {
  id                   String                 @id @default(cuid())
  productId            String
  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  title                String                 // e.g. "Small / Black"
  sku                  String                 @unique
  barcode              String?
  priceCents           Int                    // stored in integer cents (e.g. 4999 = $49.99)
  compareAtPriceCents  Int?
  costPerItemCents     Int?
  weightGrams          Int?
  inventoryQuantity    Int                    @default(0)
  reservedQuantity     Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  media                ProductMedia[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  reservations         InventoryReservation[]

  @@index([productId])
  @@index([sku])
}

model ProductMedia {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  altText   String?
  position  Int             @default(0)
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

enum CollectionType {
  MANUAL
  SMART
}

model Collection {
  id             String              @id @default(cuid())
  title          String
  handle         String              @unique
  description    String?
  imageUrl       String?
  type           CollectionType      @default(MANUAL)
  rules          Json?               // AST for smart collection rules
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  products       CollectionProduct[]

  @@index([handle])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  addedAt      DateTime   @default(now())

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  firstName    String?
  lastName     String?
  phone        String?
  passwordHash String?   // optional for magic-link/passwordless accounts
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]
  carts        Cart[]
}

model Address {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName         String?
  lastName          String?
  company           String?
  address1          String
  address2          String?
  city              String
  province          String?
  country           String   @default("US")
  zip               String
  phone             String?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)

  @@index([customerId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items      CartItem[]

  @@index([customerId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     Int           @unique @default(autoincrement())
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email           String
  phone           String?
  status          OrderStatus   @default(PENDING)
  currency        String        @default("usd")
  subtotalCents   Int
  shippingCents   Int           @default(0)
  taxCents        Int           @default(0)
  discountCents   Int           @default(0)
  totalCents      Int
  paymentIntentId String?       @unique
  shippingAddress Json
  billingAddress  Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  fulfillments    Fulfillment[]
  refunds         Refund[]
  events          OrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title          String
  sku            String
  variantTitle   String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  @@index([orderId])
  @@index([variantId])
}

model Fulfillment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String   @default("FULFILLED")
  carrier        String?  // e.g. "USPS", "FedEx", "DHL"
  trackingNumber String?
  trackingUrl    String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents     Int
  reason          String?
  stripeRefundId  String?  @unique
  createdAt       DateTime @default(now())

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // e.g. "ORDER_PLACED", "PAYMENT_SUCCEEDED", "FULFILLED", "REFUNDED"
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([orderId])
}

enum ReservationStatus {
  PENDING
  COMMITTED
  EXPIRED
  CANCELLED
}

model InventoryReservation {
  id         String            @id @default(cuid())
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  checkoutId String
  quantity   Int
  expiresAt  DateTime
  status     ReservationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([variantId])
  @@index([checkoutId])
  @@index([expiresAt, status])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

model Discount {
  id                String       @id @default(cuid())
  code              String       @unique
  type              DiscountType
  value             Int          // percentage basis points or integer cents
  minSubtotalCents  Int?
  maxUses           Int?
  usedCount         Int          @default(0)
  perCustomerLimit  Int?
  startsAt          DateTime     @default(now())
  endsAt            DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([code])
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  source      String   // e.g. "stripe"
  eventType   String   // e.g. "payment_intent.succeeded"
  processedAt DateTime @default(now())

  @@index([eventId])
}

model PageSection {
  id          String   @id @default(cuid())
  sectionType String   // e.g. "Hero", "FeaturedCollection", "PromotionalBanner"
  position    Int      @default(0)
  isVisible   Boolean  @default(true)
  settings    Json     // configuration JSON schema
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
