# Database (PostgreSQL 17)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/shopify_ecommerce?schema=public"

# Redis (Cart & Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Meilisearch (Faceted Catalog Search)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_MASTER_KEY="meilimasterkey1234567890"

# Cloudflare R2 / S3 Storage (Media Pipeline)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="storefront-assets"
R2_PUBLIC_DOMAIN="https://pub-your-id.r2.dev"

# Authentication & Session Secrets (min 32 chars)
AUTH_SECRET="production_grade_jwt_secret_key_32_characters_minimum_random"

# Stripe (Checkout & Webhooks)
STRIPE_SECRET_KEY="sk_test_mock"
STRIPE_PUBLISHABLE_KEY="pk_test_mock"
STRIPE_WEBHOOK_SECRET="whsec_mock"

# Store Config
NEXT_PUBLIC_STORE_NAME="Apex Merchant"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
